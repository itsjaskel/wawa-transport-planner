# Copia este archivo a .env solo si quieres cambiar los valores por defecto.
# El compose trae todos estos valores incorporados, así que `docker compose up`
# funciona sin crear ningún .env.

# Puerto del servidor de desarrollo de Vite publicado en el host.
WEB_PORT=5173

# Puerto de la api publicado en el host.
API_PORT=3000

# Puerto de MongoDB publicado en el host. Deliberadamente distinto de 27017
# para no chocar con un MongoDB ya instalado en la máquina del evaluador.
MONGO_PORT=27018

# Origen permitido por CORS en la api. Debe coincidir con la url del frontend.
CORS_ORIGIN=http://localhost:5173

# Url que el navegador usa para llamar a la api. Vite la incrusta en tiempo de
# compilación, no de ejecución.
VITE_API_URL=http://localhost:3000/api
